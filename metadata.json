{
  "name": "souldo-gpno",
  "version": "2.0.0-rc.0",
  "author": "Matthew Stone",
  "summary": "Transform Microsoft GPOs into Puppet-native resources and Hiera data. No DSC.",
  "license": "Apache-2.0",
  "source": "https://github.com/matthewrstone/gpno",
  "project_page": "https://github.com/matthewrstone/gpno",
  "issues_url": "https://github.com/matthewrstone/gpno/issues",
  "dependencies": [
    {
      "name": "puppetlabs-registry",
      "version_requirement": ">= 4.0.0 < 6.0.0"
    },
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "windows",
      "operatingsystemrelease": [
        "2016",
        "2019",
        "2022",
        "2025",
        "10",
        "11"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ]
}
